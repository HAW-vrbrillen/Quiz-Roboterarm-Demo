  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Unsere Produktion hat \n - 2 Produkttypen PT und \n - 4 Machinecells MC.\n\n
    PT0: Fahrwerk und \n PT1 = Chassis.\n Beide werden werden fertig montiert.\n
    Jeder Produkttyp hat anderen \n Arbeitsplan (Sequenz, Bearbeitungszeit).\n\t\nMC0
    = Fahrwerk Shanghai\nMC1 = Motor-Kapstadt\nMC2  = Chassis-Vorne Hamburg\nMC3
    = Chassis-Hinten Bordeaux  \n\nIhre Aufgaben:\n1.  Aktuelle Situation analysieren.\n    
    Gibt es Wartezeiten?\n2. \xC4ndern Sie den Arbeitsplan PT0\n     nun MC3 vor
    MC2.\n     Was beobachten Sie?\n\nViel Erfolg w\xFCnscht Prof. Isenberg"
  m_isRightToLeft: 0
